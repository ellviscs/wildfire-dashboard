# Copy this file to .env and fill in your key.
# NASA FIRMS MAP KEY
# Get yours free at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
VITE_NASA_FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY_HERE

# FIRMS data source — choose one:
#   MODIS_NRT             (MODIS Near Real-Time, 1km resolution)
#   VIIRS_SNPP_NRT        (VIIRS Suomi-NPP, 375m resolution) ← recommended
#   VIIRS_NOAA20_NRT      (VIIRS NOAA-20, 375m resolution)
VITE_FIRMS_SOURCE=VIIRS_SNPP_NRT
